{
  "info": {
    "name": "CoffeeNChill Part 2 - Order Queue Producer",
    "description": "Covers POST /api/orders/queue against docs/CONTRACTS.md's brief-aligned contract (order-processing-queue, server-computed TotalPrice, SKU validation against MenuItems). Run top to bottom: the first two requests seed the menu items the order tests depend on.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Seed: create Cappuccino (CAP-001, available)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"category\":\"Hot Drinks\",\"sku\":\"CAP-001\",\"name\":\"Cappuccino\",\"description\":\"Espresso with steamed milk foam\",\"price\":35.00,\"isAvailable\":true}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/menu"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Created', () => pm.expect([200, 201]).to.include(pm.response.code));"
          ]
        }
      }]
    },
    {
      "name": "Seed: create Croissant (CRO-003, available)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"category\":\"Pastries\",\"sku\":\"CRO-003\",\"name\":\"Croissant\",\"description\":\"Butter croissant\",\"price\":25.00,\"isAvailable\":true}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/menu"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Created', () => pm.expect([200, 201]).to.include(pm.response.code));"
          ]
        }
      }]
    },
    {
      "name": "Seed: create Stale Muffin (STL-004, unavailable)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"category\":\"Pastries\",\"sku\":\"STL-004\",\"name\":\"Stale Muffin\",\"description\":\"Deliberately seeded as unavailable for the negative test below\",\"price\":20.00,\"isAvailable\":false}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/menu"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Created', () => pm.expect([200, 201]).to.include(pm.response.code));"
          ]
        }
      }]
    },
    {
      "name": "Queue a valid order",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"customerName\":\"Thandi\",\"items\":[{\"category\":\"Hot Drinks\",\"sku\":\"CAP-001\",\"quantity\":2},{\"category\":\"Pastries\",\"sku\":\"CRO-003\",\"quantity\":1}]}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders/queue"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Accepted', () => pm.response.to.have.status(202));",
            "pm.test('Returns a server-generated ORD-yyyy-NNNNN orderId', () => pm.expect(pm.response.json().orderId).to.match(/^ORD-\\d{4}-\\d{5}$/));",
            "pm.test('Returns itemCount matching the payload', () => pm.expect(pm.response.json().itemCount).to.eql(2));",
            "pm.test('TotalPrice is server-computed from menu prices (2x35.00 + 1x25.00 = 95.00)', () => pm.expect(pm.response.json().totalPrice).to.eql(95.00));",
            "pm.test('Returns an OrderTimestamp', () => pm.expect(pm.response.json().orderTimestamp).to.not.be.empty);"
          ]
        }
      }]
    },
    {
      "name": "Queue order without customer name (optional field)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"category\":\"Hot Drinks\",\"sku\":\"CAP-001\",\"quantity\":1}]}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders/queue"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Accepted', () => pm.response.to.have.status(202));",
            "pm.test('TotalPrice is 35.00 for a single CAP-001', () => pm.expect(pm.response.json().totalPrice).to.eql(35.00));"
          ]
        }
      }]
    },
    {
      "name": "Reject empty items list",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"customerName\":\"Thandi\",\"items\":[]}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders/queue"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));"
          ]
        }
      }]
    },
    {
      "name": "Reject item with missing SKU",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"category\":\"Hot Drinks\",\"sku\":\"\",\"quantity\":1}]}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders/queue"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));"
          ]
        }
      }]
    },
    {
      "name": "Reject non-positive quantity",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"category\":\"Hot Drinks\",\"sku\":\"CAP-001\",\"quantity\":0}]}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders/queue"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));"
          ]
        }
      }]
    },
    {
      "name": "Reject malformed JSON body",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "not json",
          "options": { "raw": { "language": "text" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders/queue"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));"
          ]
        }
      }]
    },
    {
      "name": "Reject unknown SKU",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"category\":\"Hot Drinks\",\"sku\":\"ZZZ-999\",\"quantity\":1}]}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders/queue"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));",
            "pm.test('Error names the unknown SKU', () => pm.expect(pm.response.json().error).to.include('ZZZ-999'));"
          ]
        }
      }]
    },
    {
      "name": "Reject unavailable item",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"category\":\"Pastries\",\"sku\":\"STL-004\",\"quantity\":1}]}",
          "options": { "raw": { "language": "json" } }
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/orders/queue"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));",
            "pm.test('Error names the unavailable SKU', () => pm.expect(pm.response.json().error).to.include('STL-004'));"
          ]
        }
      }]
    }
  ]
}
