{
  "info": {
    "_postman_id": "7c2f6a3e-4b8d-4e1a-9c5f-2d8b6a0e7f31",
    "name": "CoffeeNChill Part 2",
    "description": "The canonical Part 2 collection: full Part 1 menu/staff-document coverage plus the order queue producer, the queue-triggered processing lifecycle, and status transitions. Supersedes CoffeeNChill-Part2-Orders.postman_collection.json (Phase 1 only), which this replaces. Run top to bottom, unattended, against docker compose up -d or func start.\n\nPoison-queue demo (optional, not automated here - Postman can't place a raw message on a queue): push a malformed message directly with the Azure CLI against the running compose stack, e.g.\n\n  az storage message put --queue-name order-processing-queue --content \"$(echo -n 'not valid json at all' | base64)\" --connection-string \"DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;\"\n\nthen watch `docker logs coffeenchill-functions` show 5 retries before the message moves to order-processing-queue-poison and a row appears in FailedOrders (or use Azure Storage Explorer pointed at the same connection string to see both queues and the FailedOrders table directly).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Menu",
      "item": [
        {
          "name": "Seed: create Cappuccino (CAP-001, available)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"category\": \"Hot Drinks\",\n  \"sku\": \"CAP-001\",\n  \"name\": \"Cappuccino\",\n  \"description\": \"Espresso with steamed milk foam\",\n  \"price\": 35.00,\n  \"isAvailable\": true\n}" },
            "url": "{{baseUrl}}/api/menu"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Created', () => pm.expect([200, 201]).to.include(pm.response.code));"
          ] } }]
        },
        {
          "name": "Seed: create Croissant (CRO-003, available)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"category\": \"Pastries\",\n  \"sku\": \"CRO-003\",\n  \"name\": \"Croissant\",\n  \"description\": \"Butter croissant\",\n  \"price\": 25.00,\n  \"isAvailable\": true\n}" },
            "url": "{{baseUrl}}/api/menu"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Created', () => pm.expect([200, 201]).to.include(pm.response.code));"
          ] } }]
        },
        {
          "name": "Seed: create Stale Muffin (STL-004, unavailable)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"category\": \"Pastries\",\n  \"sku\": \"STL-004\",\n  \"name\": \"Stale Muffin\",\n  \"description\": \"Deliberately seeded unavailable for the negative order test below\",\n  \"price\": 20.00,\n  \"isAvailable\": false\n}" },
            "url": "{{baseUrl}}/api/menu"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Created', () => pm.expect([200, 201]).to.include(pm.response.code));"
          ] } }]
        },
        {
          "name": "Create menu item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"category\": \"{{category}}\",\n  \"sku\": \"{{itemId}}\",\n  \"name\": \"Espresso\",\n  \"description\": \"Double-shot campus espresso\",\n  \"price\": 29.95,\n  \"isAvailable\": true\n}" },
            "url": "{{baseUrl}}/api/menu"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Created', () => pm.response.to.have.status(201));",
            "pm.test('Returns created SKU', () => pm.expect(pm.response.json().rowKey).to.eql(pm.environment.get('itemId')));"
          ] } }]
        },
        {
          "name": "Get all menu items",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/menu" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('OK', () => pm.response.to.have.status(200));",
            "pm.test('Returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ] } }]
        },
        {
          "name": "Get menu items by category",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/menu/category/{{category}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('OK', () => pm.response.to.have.status(200));",
            "pm.test('All rows match category', () => pm.response.json().forEach(x => pm.expect(x.partitionKey).to.eql(pm.environment.get('category'))));"
          ] } }]
        },
        {
          "name": "Update menu item",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 31.50,\n  \"isAvailable\": false\n}" },
            "url": "{{baseUrl}}/api/menu/{{category}}/{{itemId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('OK', () => pm.response.to.have.status(200));",
            "pm.test('Values updated', () => { const x = pm.response.json(); pm.expect(x.price).to.eql(31.5); pm.expect(x.isAvailable).to.eql(false); });"
          ] } }]
        },
        {
          "name": "Delete menu item",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/menu/{{category}}/{{itemId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('No content', () => pm.response.to.have.status(204));"
          ] } }]
        }
      ]
    },
    {
      "name": "Staff Documents",
      "item": [
        {
          "name": "Upload staff document",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "sample-staff-document.txt" }] },
            "url": "{{baseUrl}}/api/documents/upload"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Created', () => pm.response.to.have.status(201));",
            "pm.test('Returns file metadata', () => pm.expect(pm.response.json().fileName).to.eql(pm.environment.get('fileName')));"
          ] } }]
        },
        {
          "name": "List staff documents",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/documents" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('OK', () => pm.response.to.have.status(200));",
            "pm.test('Contains uploaded file', () => pm.expect(pm.response.json().some(x => x.fileName === pm.environment.get('fileName'))).to.eql(true));"
          ] } }]
        },
        {
          "name": "Download staff document",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/documents/download/{{fileName}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('OK', () => pm.response.to.have.status(200));",
            "pm.test('Has content', () => pm.expect(pm.response.text().length).to.be.above(0));"
          ] } }]
        },
        {
          "name": "Delete staff document",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/documents/{{fileName}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('No content', () => pm.response.to.have.status(204));"
          ] } }]
        }
      ]
    },
    {
      "name": "Orders: Queue",
      "item": [
        {
          "name": "Queue a valid order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerName\": \"Thandi\",\n  \"items\": [\n    { \"category\": \"Hot Drinks\", \"sku\": \"CAP-001\", \"quantity\": 2 },\n    { \"category\": \"Pastries\", \"sku\": \"CRO-003\", \"quantity\": 1 }\n  ]\n}" },
            "url": "{{baseUrl}}/api/orders/queue"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Accepted', () => pm.response.to.have.status(202));",
            "const json = pm.response.json();",
            "pm.test('Returns a server-generated ORD-yyyy-NNNNN orderId', () => pm.expect(json.orderId).to.match(/^ORD-\\d{4}-\\d{5}$/));",
            "pm.test('TotalPrice is server-computed (2x35.00 + 1x25.00 = 95.00)', () => pm.expect(json.totalPrice).to.eql(95.00));",
            "pm.environment.set('orderId', json.orderId);",
            "pm.environment.set('orderTotalPrice', json.totalPrice);",
            "pm.environment.set('orderDate', new Date(json.orderTimestamp).toISOString().slice(0, 10));"
          ] } }]
        },
        {
          "name": "Reject order with no items",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerName\": \"Thandi\",\n  \"items\": []\n}" },
            "url": "{{baseUrl}}/api/orders/queue"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));"
          ] } }]
        },
        {
          "name": "Reject order with a blank customer name",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerName\": \"   \",\n  \"items\": [{ \"category\": \"Hot Drinks\", \"sku\": \"CAP-001\", \"quantity\": 1 }]\n}" },
            "url": "{{baseUrl}}/api/orders/queue"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));"
          ] } }]
        },
        {
          "name": "Reject unknown SKU",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"category\": \"Hot Drinks\", \"sku\": \"ZZZ-999\", \"quantity\": 1 }]\n}" },
            "url": "{{baseUrl}}/api/orders/queue"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));",
            "pm.test('Error names the unknown SKU', () => pm.expect(pm.response.json().error).to.include('ZZZ-999'));"
          ] } }]
        },
        {
          "name": "Reject unavailable item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"category\": \"Pastries\", \"sku\": \"STL-004\", \"quantity\": 1 }]\n}" },
            "url": "{{baseUrl}}/api/orders/queue"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));",
            "pm.test('Error names the unavailable SKU', () => pm.expect(pm.response.json().error).to.include('STL-004'));"
          ] } }]
        }
      ]
    },
    {
      "name": "Orders: Processing",
      "item": [
        {
          "name": "Wait for the lifecycle, then verify Collected",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderDate}}/{{orderId}}" },
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "// The actual wait (ProcessOrderQueue needs ~9-10s worst case to reach",
                "// Collected: 3 remaining steps x 3s OrderStatusStepDelaySeconds) happens",
                "// in docs/run-tests.sh/.ps1 as a real shell sleep BEFORE this folder is",
                "// run, not here. A pre-request busy-wait was tried first and rejected:",
                "// spinning the CPU for ~12s inside newman's own process measurably",
                "// starved the containers of CPU on this machine and the order was still",
                "// only 'Received' afterwards - a real, non-blocking sleep doesn't have",
                "// that problem. See the Orders: Processing section of run-tests.sh.",
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Status is Collected', () => pm.expect(json.status).to.eql('Collected'));",
                "pm.test('StatusHistory passed through all 4 stages in order', () => {",
                "  pm.expect(json.statusHistory.map(h => h.status)).to.eql(['Received', 'Preparing', 'Ready', 'Collected']);",
                "});",
                "pm.test('TotalPrice still matches the original 95.00', () => pm.expect(json.totalPrice).to.eql(Number(pm.environment.get('orderTotalPrice'))));"
              ] }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders: Status",
      "item": [
        {
          "name": "Queue a fresh order for status testing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerName\": \"Palee\",\n  \"items\": [{ \"category\": \"Hot Drinks\", \"sku\": \"CAP-001\", \"quantity\": 1 }]\n}" },
            "url": "{{baseUrl}}/api/orders/queue"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Accepted', () => pm.response.to.have.status(202));",
            "const json = pm.response.json();",
            "pm.environment.set('statusTestOrderId', json.orderId);",
            "pm.environment.set('statusTestOrderDate', new Date(json.orderTimestamp).toISOString().slice(0, 10));",
            "pm.environment.unset('_statusRetryCount');"
          ] } }]
        }
      ]
    },
    {
      "name": "Orders: Status Transitions",
      "item": [
        {
          "name": "PUT valid forward transition (200 on a fresh order)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderDate\": \"{{statusTestOrderDate}}\",\n  \"orderId\": \"{{statusTestOrderId}}\",\n  \"status\": \"Preparing\"\n}" },
            "url": "{{baseUrl}}/api/orders/status"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// A 202 from the queue endpoint means the message was queued, not that",
                "// ProcessOrderQueue has dequeued and written the Received row yet (that",
                "// took ~1.5-4s in practice, observed to vary with system load). Rather",
                "// than guess a fixed wait - tried first, and genuinely flaky both ways:",
                "// too short and the row doesn't exist yet (404); too long and",
                "// ProcessOrderQueue's own background loop may have already advanced the",
                "// order past the target status - this retries on 404 instead, polling",
                "// roughly once a second (see the test script below) until the row exists,",
                "// then fires immediately. Targeting Preparing specifically (the earliest",
                "// possible forward status, not a later jump) maximizes the safety margin",
                "// on the far side too: once Received is detected, ProcessOrderQueue still",
                "// needs a further 3s before writing Preparing itself.",
                "const retryCount = Number(pm.environment.get('_statusRetryCount') || 0);",
                "if (retryCount > 0) {",
                "  const waitUntil = Date.now() + 700;",
                "  while (Date.now() < waitUntil) { /* short, bounded busy-wait between retries */ }",
                "}"
              ] }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "if (pm.response.code === 404) {",
                "  const retryCount = Number(pm.environment.get('_statusRetryCount') || 0) + 1;",
                "  if (retryCount <= 10) {",
                "    pm.environment.set('_statusRetryCount', retryCount);",
                "    pm.execution.setNextRequest(pm.info.requestName);",
                "    return;",
                "  }",
                "  pm.test('Received row existed within 10 retries', () => { throw new Error('order never appeared after ~10s of polling'); });",
                "  return;",
                "}",
                "pm.environment.unset('_statusRetryCount');",
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "pm.test('Status is now Preparing', () => pm.expect(pm.response.json().status).to.eql('Preparing'));"
              ] }
            }
          ]
        },
        {
          "name": "PUT backward transition (400)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderDate\": \"{{statusTestOrderDate}}\",\n  \"orderId\": \"{{statusTestOrderId}}\",\n  \"status\": \"Received\"\n}" },
            "url": "{{baseUrl}}/api/orders/status"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));"
          ] } }]
        },
        {
          "name": "PUT status for an unknown order (404)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderDate\": \"{{statusTestOrderDate}}\",\n  \"orderId\": \"ORD-DOES-NOT-EXIST\",\n  \"status\": \"Ready\"\n}" },
            "url": "{{baseUrl}}/api/orders/status"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Not found', () => pm.response.to.have.status(404));"
          ] } }]
        }
      ]
    }
  ]
}
